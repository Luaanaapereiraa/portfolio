# Referência das variáveis do site. Os valores de produção ficam em .env.production
# (são públicos: aparecem no HTML/JS publicado de qualquer forma).

# Google Analytics 4 — ID do fluxo de dados da Web (Admin → Fluxos de dados → ID da métrica).
# Sem este valor o GA não carrega e o aviso de cookies não aparece.
VITE_GA_MEASUREMENT_ID=

# Google Search Console — método "Tag HTML": só o valor de content="..." da meta tag.
# Com este valor, o build injeta <meta name="google-site-verification"> no <head>.
VITE_GOOGLE_SITE_VERIFICATION=
